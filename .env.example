# Vercel AI Gateway — required. Covers every model in the sweep except ElevenLabs.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# ElevenLabs — optional. Scribe is not a gateway provider, so it needs a direct API key.
# Without this, the Scribe rows are skipped and the rest of the sweep runs normally.
ELEVENLABS_API_KEY=
