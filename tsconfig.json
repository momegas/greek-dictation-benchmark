{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "These scripts run under tsx with extensionless relative imports. Node target only — no DOM, no JSX.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
